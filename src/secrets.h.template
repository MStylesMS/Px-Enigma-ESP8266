// secrets.h.template — compile-time fallback defaults.
//
// HOW TO USE:
//   cp src/secrets.h.template src/secrets.h
//   # src/secrets.h is gitignored; never commit it.
//
// IMPORTANT: All runtime credentials (WiFi SSID/password, MQTT host/user/pass,
// AP password) live in data/config.json, NOT in this file. Copy
// config.json.example to data/config.json and fill in your site values before
// running `pio run -t uploadfs`.
//
// This file defines compile-time fallback constants used only when
// data/config.json is absent or corrupt. They are baked into the firmware
// binary so the device comes up with some sensible defaults even on a fresh
// flash with no filesystem image.
#pragma once

// Default AP password when data/config.json cannot be loaded.
// Set this to something site-specific if the prop will be deployed without a
// pre-configured filesystem image. Operators should change it via the Web UI.
#define SECRETS_AP_PASSWORD_DEFAULT  "MCEscher"

// Default OTA endpoint password (HTTP /update and ArduinoOTA).
// Should be changed via the Web UI once the prop is online.
#define SECRETS_OTA_PASSWORD_DEFAULT "MCEscher"
